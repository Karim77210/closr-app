rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return request.auth.uid == userId;
    }

    // Users collection
    // Users can only read their own document and creators can be read by anyone
    match /users/{userId} {
      // Allow authenticated users to create their own document
      allow create: if isSignedIn() && isUser(userId);
      
      // Allow unauthenticated username queries (for signup uniqueness check)
      allow list: if true;
      // Allow authenticated users to read any profile
      allow get: if isSignedIn();
      // Allow public read of active creators
      allow get: if resource.data.role == 'creator' && resource.data.isActive == true;
      
      // Allow users to update their own document
      allow update: if isSignedIn() && isUser(userId) && 
                       // Prevent changing role and role directly (must be done server-side)
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'email', 'createdAt']) &&
                       request.resource.data.updatedAt == request.time;
      
      // Only allow deletion through server-side functions
      allow delete: if false;

    }

    // Subscriptions collection (top-level)
    // Writes are exclusively via Cloud Functions (admin SDK bypasses these rules).
    // Reads are allowed for the subscriber and the creator of the subscription.
    match /subscriptions/{subscriptionId} {
      allow create: if false;
      allow read: if isSignedIn() && (
        resource.data.subscriberUid == request.auth.uid ||
        resource.data.creatorUid == request.auth.uid
      );
      allow update: if false;
      allow delete: if false;
    }

    // Conversations collection (1:1 chat)
    match /conversations/{conversationId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        request.resource.data.subscriberUid == request.auth.uid ||
        request.resource.data.creatorUid == request.auth.uid
      );

      match /messages/{messageId} {
        allow create: if isSignedIn() && isUser(request.resource.data.senderId);
        allow read: if isSignedIn();
        allow update, delete: if false;
      }
    }

    // Payout requests — creator creates, Cloud Functions update
    match /payout_requests/{id} {
      allow create: if isSignedIn() && isUser(request.resource.data.creatorUid);
      allow read: if isSignedIn() && isUser(resource.data.creatorUid);
      allow update, delete: if false;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
